# RoastMyX — environment variables
# Copy to .env.local and fill in values

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# xAI — powers the roast (server-side only)
# Get a key: https://console.x.ai
XAI_API_KEY=
# Optional model override (default: grok-4-1-fast-non-reasoning)
# XAI_MODEL=grok-4-1-fast-non-reasoning

# X (Twitter) API v2 Bearer Token — live public profiles
# https://developer.x.com
X_BEARER_TOKEN=
# Alias also accepted:
# TWITTER_BEARER_TOKEN=

# When X API fails or is missing, fall back to demo profiles (default: true)
ALLOW_DEMO_FALLBACK=true
